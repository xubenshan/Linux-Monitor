        </mxCell>
        <mxCell id="proc" value="&lt;b&gt;procfs / sysfs&lt;/b&gt;&lt;br&gt;loadavg · meminfo&lt;br&gt;diskstats · net/dev" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="worker">
          <mxGeometry x="210" y="60" width="160" height="90" as="geometry"/>
        </mxCell>
