          <mxGeometry x="390" y="60" width="160" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="collectors" value="&lt;b&gt;MetricCollector&lt;/b&gt;&lt;br&gt;统一调用 MonitorInter::UpdateOnce&lt;br&gt;计算两次采样差值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="worker">
