        </mxCell>
        <mxCell id="proto" value="&lt;b&gt;MonitorInfo&lt;/b&gt;&lt;br&gt;Protobuf 指标快照&lt;br&gt;主机 + CPU + 内存 + 网络 + 磁盘" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="worker">
