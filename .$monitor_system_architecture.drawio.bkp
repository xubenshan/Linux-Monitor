<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0">
  <diagram id="monitor_system" name="monitor_system架构">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="monitor_system 分布式性能监控系统架构" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="560" height="30" as="geometry" />
        </mxCell>

        <!-- ============ WORKER 容器 ============ -->
        <mxCell id="worker_box" value="Worker（被监控机，每台部署一个）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1A1A1A;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="440" height="620" as="geometry" />
        </mxCell>

        <!-- 采集层标签 -->
        <mxCell id="w_collect_label" value="① 采集层（策略模式，统一 Monitor.UpdateOnce 接口）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#3A5A85;" vertex="1" parent="1">
          <mxGeometry x="80" y="115" width="400" height="20" as="geometry" />
        </mxCell>

        <!-- 内核模块 -->
        <mxCell id="kmod" value="内核模块 (kmod)&#10;cpu_stat_collector.ko / softirq_collector.ko&#10;hrtimer 每秒刷新 → 字符设备 /dev/*&#10;→ mmap 共享内存（零拷贝读取）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="400" height="70" as="geometry" />
        </mxCell>

        <!-- eBPF -->
        <mxCell id="ebpf" value="eBPF (net_stats.bpf.c)&#10;TC ingress / egress hook&#10;在协议栈层按网卡统计收发字节/包数&#10;→ BPF Hash Map 暴露给用户态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="400" height="70" as="geometry" />
        </mxCell>

        <!-- procfs -->
        <mxCell id="procfs" value="procfs 采集器&#10;mem (/proc/meminfo)、disk (/proc/diskstats)&#10;load (/proc/loadavg)、net (/proc/net/dev)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="300" width="400" height="60" as="geometry" />
        </mxCell>

        <!-- 聚合层 -->
        <mxCell id="collector" value="② 聚合层  MetricCollector.CollectAll()&#10;驱动所有采集器 → 组装成 MonitorInfo (protobuf)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="400" width="400" height="60" as="geometry" />
        </mxCell>

        <!-- 推送层 -->
        <mxCell id="pusher" value="③ 推送层  MonitorPusher（独立线程）&#10;每 10 秒通过 gRPC 主动推送（Push 模式）&#10;主机唯一标识：hostname_ip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="490" width="400" height="70" as="geometry" />
        </mxCell>

        <!-- worker内部箭头 -->
        <mxCell id="e_kmod_col" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;strokeWidth=1.5;" edge="1" parent="1" source="kmod" target="collector"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_ebpf_col" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;strokeWidth=1.5;" edge="1" parent="1" source="ebpf" target="collector"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_proc_col" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;strokeWidth=1.5;" edge="1" parent="1" source="procfs" target="collector"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_col_push" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#82B366;strokeWidth=2;" edge="1" parent="1" source="collector" target="pusher"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ gRPC 传输箭头 ============ -->
        <mxCell id="grpc_arrow" value="gRPC SetMonitorInfo(MonitorInfo)&#10;protobuf 序列化 · 每 10s" style="html=1;endArrow=block;endFill=1;strokeColor=#B85450;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#B85450;rounded=0;" edge="1" parent="1" source="pusher" target="manager_grpc">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="525" as="sourcePoint" />
            <mxPoint x="640" y="180" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ============ MANAGER 容器 ============ -->
        <mxCell id="manager_box" value="Manager（管理端，一个）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1A1A1A;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="640" y="80" width="470" height="620" as="geometry" />
        </mxCell>

        <!-- gRPC Server 接收 -->
        <mxCell id="manager_grpc" value="gRPC Server (:50051)&#10;SetMonitorInfo() 接收 Worker 上报" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="130" width="430" height="55" as="geometry" />
        </mxCell>

        <!-- HostManager -->
        <mxCell id="hostmgr" value="HostManager（核心处理）&#10;&#10;• CalcScore() 五维加权健康评分&#10;   CPU35% + 内存30% + 负载15% + 磁盘15% + 网络5%&#10;• 各指标环比变化率计算&#10;• 写入 5 张 MySQL 表&#10;• ProcessLoop：60s 未上报判离线并剔除" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="660" y="215" width="430" height="130" as="geometry" />
        </mxCell>

        <!-- MySQL -->
        <mxCell id="mysql" value="MySQL  monitor_db&#10;server_performance（主表）&#10;+ 网络 / 磁盘 / 内存 / 软中断 明细表" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="375" width="350" height="100" as="geometry" />
        </mxCell>

        <!-- QueryService -->
        <mxCell id="query" value="QueryService  9 个 gRPC 查询接口&#10;历史数据(分页) · 趋势 · 异常检测&#10;评分排名（支撑“选最优服务器”调度决策）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="500" width="430" height="80" as="geometry" />
        </mxCell>

        <!-- 外部查询方 -->
        <mxCell id="client" value="查询客户端 / 调度系统" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="770" y="620" width="210" height="50" as="geometry" />
        </mxCell>

        <!-- manager内部箭头 -->
        <mxCell id="e_grpc_host" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;strokeWidth=2;" edge="1" parent="1" source="manager_grpc" target="hostmgr"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_host_mysql" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;strokeWidth=2;" edge="1" parent="1" source="hostmgr" target="mysql"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_mysql_query" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;strokeWidth=2;" edge="1" parent="1" source="mysql" target="query"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_query_client" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#9673A6;strokeWidth=2;dashed=1;" edge="1" parent="1" source="query" target="client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 技术栈说明 -->
        <mxCell id="techstack" value="技术栈：C++17 · 内核模块 · eBPF/libbpf · gRPC + Protobuf · MySQL · CMake · 多线程" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="720" width="1050" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
