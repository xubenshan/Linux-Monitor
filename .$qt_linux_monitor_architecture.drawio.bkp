<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0">
  <diagram id="qt_monitor" name="qt-linux-monitor架构">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="qt-linux-monitor 图形化系统监视器架构（单机 · 桌面 GUI）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="220" y="20" width="720" height="30" as="geometry" />
        </mxCell>

        <!-- 来源说明 -->
        <mxCell id="src" value="来源：基于 GPLv3 开源项目二次开发（源码版权头 Copyright (C) 2017 Lily Rivers）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="220" y="52" width="720" height="20" as="geometry" />
        </mxCell>

        <!-- ============ 主线程 GUI 容器 ============ -->
        <mxCell id="gui_box" value="MainWindow（主线程 / GUI）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1A1A1A;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="300" y="90" width="560" height="130" as="geometry" />
        </mxCell>

        <mxCell id="tabs" value="Tab 页：资源 | 进程 | 文件系统" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#82B366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="320" y="125" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="plot" value="QCustomPlot 实时曲线&#10;CPU / 网络 折线图&#10;+ 进度条（内存 / Swap）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#82B366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="590" y="125" width="250" height="70" as="geometry" />
        </mxCell>

        <!-- signal/slot 说明 -->
        <mxCell id="ss_label" value="▲ Qt signal / slot 跨线程通信（worker 采集完发信号，主线程更新 UI）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="300" y="235" width="560" height="20" as="geometry" />
        </mxCell>

        <!-- ============ 三个 worker 线程 ============ -->
        <mxCell id="res_worker" value="resourcesWorker（线程）&#10;&#10;CPU 使用率 / 内存 / 网络&#10;两次采样求差值算速率" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=center;verticalAlign=top;spacingTop=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="290" width="270" height="100" as="geometry" />
        </mxCell>

        <mxCell id="proc_worker" value="processInfoWorker（线程）&#10;&#10;进程列表、CPU/内存占用&#10;PID、状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=center;verticalAlign=top;spacingTop=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="290" width="270" height="100" as="geometry" />
        </mxCell>

        <mxCell id="fs_worker" value="fileSystemWorker（线程）&#10;&#10;磁盘挂载点&#10;容量 / 已用 / 使用率" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=center;verticalAlign=top;spacingTop=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="290" width="270" height="100" as="geometry" />
        </mxCell>

        <!-- signal/slot 双向箭头 -->
        <mxCell id="e_res_gui" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;strokeWidth=2;" edge="1" parent="1" source="res_worker" target="gui_box"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_proc_gui" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;strokeWidth=2;" edge="1" parent="1" source="proc_worker" target="gui_box"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_fs_gui" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;strokeWidth=2;" edge="1" parent="1" source="fs_worker" target="gui_box"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ 数据源 ============ -->
        <mxCell id="ds_res" value="/proc/stat&#10;/proc/meminfo&#10;/proc/net/dev" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="150" y="450" width="210" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ds_proc" value="/proc/[pid]/*&#10;libprocps (procps API)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="480" y="450" width="210" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ds_fs" value="statvfs()&#10;/proc/mounts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="810" y="450" width="210" height="80" as="geometry" />
        </mxCell>

        <!-- worker → 数据源箭头 -->
        <mxCell id="e_res_ds" value="定时轮询" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="res_worker" target="ds_res"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_proc_ds" value="定时轮询" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="proc_worker" target="ds_proc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_fs_ds" value="定时轮询" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="fs_worker" target="ds_fs"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- 数据源层标签 -->
        <mxCell id="ds_label" value="数据源：Linux 内核 /proc 文件系统 + 系统库（纯用户态读取，无内核模块/无网络/无持久化）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="150" y="545" width="870" height="20" as="geometry" />
        </mxCell>

        <!-- 技术栈 -->
        <mxCell id="techstack" value="技术栈：C++17 · Qt5 (Core/Gui/Widgets) · QCustomPlot · libprocps · 多线程 · CMake" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="150" y="590" width="870" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
