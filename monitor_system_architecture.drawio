        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#1A1A1A;" value="monitor_system 分布式性能监控系统架构" vertex="1">
          <mxGeometry height="30" width="560" x="300" y="20" as="geometry" />
        </mxCell>
        <mxCell id="worker_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1A1A1A;arcSize=3;" value="Worker（被监控机，每台部署一个）" vertex="1">
          <mxGeometry height="620" width="440" x="60" y="80" as="geometry" />
        </mxCell>
        <mxCell id="w_collect_label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#3A5A85;" value="① 采集层（策略模式，统一 Monitor.UpdateOnce 接口）" vertex="1">
          <mxGeometry height="20" width="400" x="80" y="115" as="geometry" />
        </mxCell>
        <mxCell id="kmod" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="内核模块 (kmod)&#xa;cpu_stat_collector.ko / softirq_collector.ko&#xa;hrtimer 每秒刷新 → 字符设备 /dev/*&#xa;→ mmap 共享内存（零拷贝读取）" vertex="1">
          <mxGeometry height="70" width="400" x="80" y="140" as="geometry" />
        </mxCell>
        <mxCell id="ebpf" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="eBPF (net_stats.bpf.c)&#xa;TC ingress / egress hook&#xa;在协议栈层按网卡统计收发字节/包数&#xa;→ BPF Hash Map 暴露给用户态" vertex="1">
          <mxGeometry height="70" width="400" x="80" y="220" as="geometry" />
        </mxCell>
        <mxCell id="procfs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="procfs 采集器&#xa;mem (/proc/meminfo)、disk (/proc/diskstats)&#xa;load (/proc/loadavg)、net (/proc/net/dev)" vertex="1">
          <mxGeometry height="60" width="400" x="80" y="300" as="geometry" />
        </mxCell>
        <mxCell id="collector" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" value="② 聚合层  MetricCollector.CollectAll()&#xa;驱动所有采集器 → 组装成 MonitorInfo (protobuf)" vertex="1">
          <mxGeometry height="60" width="400" x="80" y="400" as="geometry" />
        </mxCell>
        <mxCell id="pusher" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" value="③ 推送层  MonitorPusher（独立线程）&#xa;每 10 秒通过 gRPC 主动推送（Push 模式）&#xa;主机唯一标识：hostname_ip" vertex="1">
