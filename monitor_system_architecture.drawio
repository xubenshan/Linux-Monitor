          <mxGeometry height="620" width="470" x="710" y="80" as="geometry" />
        </mxCell>
        <mxCell id="manager_grpc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" value="gRPC Server (:50051)&#xa;SetMonitorInfo() 接收 Worker 上报" vertex="1">
